{
    "config": {
        "default": true,
        // long lines are unavoidable in tables — don't fail on them
        "MD013": false,
        // only flag duplicate headings among siblings (every changelog version has its own "Added")
        "MD024": { "siblings_only": true },
        // nested lists indented with 4 spaces (the project's .editorconfig), not 2
        "MD007": { "indent": 4 },
        // the start of AGENTS.md is generated by `next dev`
        "MD041": false,
    },
    "ignores": ["node_modules/**", ".next/**", "out/**"],
}

{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run dev)",
            "Bash(npm run lint *)",
            "Bash(npm run lint:md *)",
            "Bash(npm run typecheck)",
            "Bash(npm run check)",
            "Bash(npm run format *)",
            "Bash(npm run format:check)",
            "Bash(npm run build)",
            "Bash(npx tsc --noEmit)",
            "Bash(npx eslint *)",
            "Bash(npx prettier *)",
            "Bash(git status *)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git show *)"
        ],
        "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
                        "timeout": 60,
                        "statusMessage": "Formatting (prettier/eslint)..."
                    }
                ]
            }
        ]
    }
}

# Local development: copy to .env.local. Vercel: set these in the project. Read at build time. Docker: see docker-compose.yml.

# Public address of the site, used in link previews. On Vercel it comes from the production domain; elsewhere, set it
NEXT_PUBLIC_SITE_URL=

# Language: en, pt-BR, pt, es, fr, de, it, cs, pl, sv, tr, id, vi, ru, uk, fa, he or zh-CN. Empty: each visitor gets their browser's language, and link previews use English.
NEXT_PUBLIC_LANGUAGE=

# Full name, shown in the header. The rest of the page uses only the first name. Default: a generic name in the page's language
NEXT_PUBLIC_OWNER_NAME=

# Photo: a public http(s) URL, such as https://github.com/YOUR_USER.png. Default: a generic avatar
NEXT_PUBLIC_OWNER_PHOTO=

# GIFs in the conversation: any public http(s) URL, swap them for your favorites. Empty: that message doesn't appear
# Shown after the voicemail comparison
NEXT_PUBLIC_GIF_1_URL=https://media.giphy.com/media/6uGhT1O4sxpi8/200w.gif
# Shown after the message about watching "typing…"
NEXT_PUBLIC_GIF_2_URL=https://media.giphy.com/media/2uwZ4xi75JhxZYeyQB/200w.gif
